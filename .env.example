# === База данных ===
# Локально Postgres крутится на 5433, чтобы не пересекаться с системным 5432
DB_HOST=localhost
DB_PORT=5433
DB_NAME=fooddiary
DB_USER=fooddiary
DB_PASSWORD=change-me

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === Приложение ===
# Аккаунт администратора, создаётся при старте (пусто = не создавать)
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change-me-strong-password
# Кеш шаблонов FreeMarker: false при разработке, true на проде
FREEMARKER_CACHE=false
# Внешний поиск продуктов через Open Food Facts (без API-ключа)
OPEN_FOOD_FACTS_ENABLED=true

# === Docker Compose ===
# Порт публикации приложения на хосте.
# На проде за Traefik, чтобы порт не торчал наружу: APP_PORT=127.0.0.1:8080
APP_PORT=8080
APP_VERSION=1.0.0

# === Только прод-деплой (docker-compose.prod.yaml, Traefik на VPS) ===
#CONTEXT_NAME=food-diary
#DOMAIN=damir.ru
#IP_HOST=203.0.113.10
